          "hsv": { "h": 208.17, "s": 75.23, "v": 85.49 },
          "cmyk": { "c": 75.23, "m": 35.32, "y": 0, "k": 14.51 },
          "xyzD65": { "x": 23.7, "y": 24.89, "z": 69.87 },
          "labD65": { "l": 56.97, "a": 0.16, "b": -46.7 },
          "oklab": { "l": 0.628, "a": -0.0511, "b": -0.1329 },
