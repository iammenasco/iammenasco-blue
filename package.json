{
  "name": "iammenasco-blue",
  "version": "1.2.0",
  "description": "Adds iammenasco-blue (#368dda) across CSS, JS/TS, Tailwind, Design Tokens, and Python!",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "style": "css/iammenasco-blue.css",
  "bin": {
    "iammenasco-blue": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./css": "./css/iammenasco-blue.css",
    "./min.css": "./css/iammenasco-blue.min.css",
    "./theme.css": "./css/theme.css",
    "./theme.min.css": "./css/theme.min.css",
    "./surfaces.css": "./css/surfaces.css",
    "./surfaces.min.css": "./css/surfaces.min.css",
    "./tailwind": "./tailwind.preset.js",
    "./tokens": "./tokens.json"
  },
  "files": [
    "bin/",
    "css/",
    "less/",
    "sass/",
    "stylus/",
    "swatches/",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "tailwind.preset.js",
    "tokens.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/verify.mjs && python3 -m unittest discover -s test -v",
    "verify": "node --test test/verify.mjs",
    "swatches": "python3 build_swatches.py",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iammenasco/iammenasco-blue.git"
  },
  "keywords": [
    "iammenasco",
    "iammenasco-blue",
    "#368dda",
    "blue",
    "color",
    "design-tokens",
    "tailwind"
  ],
  "author": "Brian Menasco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iammenasco/iammenasco-blue/issues"
  },
  "homepage": "https://github.com/iammenasco/iammenasco-blue#readme"
}
